# Azeroth Exchange website for Homebrew nginx.
# Generated by nginx/install.sh from azeroth-exchange.conf.template; edit the template, not the installed copy.
#   __FRONT__ = the shatari-front folder, __DATA__ = the back end's data folder, __PORT__ = the listening port.

server {
    listen __PORT__;
    server_name _;

    root __FRONT__/dist;
    index index.html;
    charset utf-8;

    # No visitor logs (see privacy.html). Errors are still logged by nginx.
    access_log off;

    # Never serve dotfiles, including the back end's in-progress temp files.
    location ~ /\. {
        deny all;
    }

    # The built site. Hashed build assets never change; everything else is checked hourly.
    location / {
        try_files $uri $uri/ =404;
        expires 1h;
    }
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Game data and realm lists. Uses the pre-compressed .gz copies when they exist.
    location /json/ {
        alias __FRONT__/json/;
        gzip_static on;
        add_header Cache-Control "no-cache";
    }

    # Price data from the back end. Every file is stored gzipped, so label it as such and let the browser
    # inflate it. Last-Modified (sent by default) is how the site detects new snapshots.
    location /data/cached/ {
        alias __DATA__/;
        default_type application/octet-stream;
        types {}
        gzip off;
        add_header Content-Encoding gzip;
        add_header Cache-Control "public, max-age=300";
    }
    location /data/ {
        alias __DATA__/;
        default_type application/octet-stream;
        types {}
        gzip off;
        add_header Content-Encoding gzip;
        add_header Cache-Control "no-cache";
    }
}
